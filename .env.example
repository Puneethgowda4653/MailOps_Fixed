# ── Flask ──────────────────────────────────────────────────────────────────────
# Generate a new key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=ff1ccf81c4206829670b92c485fb3712574959866ae4825c0dafcf5a96faefc3

# Set to "true" only when running behind HTTPS in production
HTTPS=false

# Set to "true" only for local development — NEVER in production
FLASK_DEBUG=false

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
MONGO_URI=mongodb://localhost:27017
MONGO_DB=mailops

# ── Redis (required for Celery scheduled sending and rate limiting) ─────────────
# Local:  redis://localhost:6379/0
# Managed: redis://:password@host:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Base URL (required for email tracking links) ───────────────────────────────
# Set this to the public URL of your deployed app, NO trailing slash
# Local dev: http://localhost:5000
# Production: https://mail.yourdomain.com
BASE_URL=http://localhost:5000

# ── Google OAuth (optional — leave blank to disable) ──────────────────────────
# Create credentials at https://console.cloud.google.com/
# Authorised redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Transactional email for system messages (password reset, verification) ─────
# Uses SendGrid. Get a free API key at https://sendgrid.com
# Leave blank to fall back to the user's own SMTP for system emails (dev only)
SENDGRID_API_KEY=
SYSTEM_EMAIL_FROM=noreply@yourdomain.com
